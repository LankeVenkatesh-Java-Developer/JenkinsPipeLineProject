# Dockerfile for building from Jenkins artifact
# This Dockerfile uses the JAR file downloaded from Jenkins instead of building from source

FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

# Copy the JAR file from Jenkins artifacts
COPY jenkins-artifacts/app.jar app.jar

# Create a non-root user
RUN addgroup -S spring && adduser -S spring -G spring
USER spring:spring

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/actuator/health || exit 1

# Run the application
ENTRYPOINT ["java", "-jar", "app.jar"]
